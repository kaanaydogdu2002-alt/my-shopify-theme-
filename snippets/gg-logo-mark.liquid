{% comment %}
  Mantel and Moss wheat mark. Uses the logo image from theme settings when one is uploaded,
  otherwise the inline SVG mark from the design system.
  Usage: {% render 'gg-logo-mark', inverse: true, size: 28 %}
{% endcomment %}
{%- liquid
  assign brand_alt = settings.gg_brand_name | strip
  if brand_alt == blank
    assign brand_alt = shop.name
  endif
  assign brand_alt = brand_alt | escape
  assign size = size | default: 28
  if inverse
    assign ink = '#FDFBF7'
  else
    assign ink = '#2B211A'
  endif
-%}
{%- if settings.logo != blank -%}
  <img src="{{ settings.logo | image_url: width: 120 }}" alt="{{ brand_alt }}" width="{{ size }}" height="{{ size }}" loading="eager">
{%- else -%}
  <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 60 60" role="img" aria-label="{{ brand_alt }}" xmlns="http://www.w3.org/2000/svg" style="overflow: visible"><g transform="translate(0 5)"><g color="{{ ink }}"><path d="M30,50 Q27,30 30,10" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path><ellipse cx="20" cy="42" rx="5" ry="11" fill="currentColor" transform="rotate(-35 20 42)"></ellipse><ellipse cx="40" cy="40" rx="5" ry="11" fill="currentColor" transform="rotate(35 40 40)"></ellipse><ellipse cx="19" cy="24" rx="5" ry="11" fill="currentColor" transform="rotate(-25 19 24)"></ellipse><ellipse cx="41" cy="22" rx="5" ry="11" fill="currentColor" transform="rotate(25 41 22)"></ellipse></g><ellipse cx="30" cy="10" rx="6" ry="14" fill="#B8912F"></ellipse></g></svg>
{%- endif -%}
