{% comment %}
  Payment method icons (official Shopify SVGs via payment_type_svg_tag).
  Source is a theme setting: a manual list (default, matches the design) or the
  methods actually enabled at checkout.
  Usage: {% render 'gg-payments', center: true %}
{% endcomment %}
{%- liquid
  if settings.gg_payment_source == 'store'
    assign types = shop.enabled_payment_types
  else
    assign raw = settings.gg_payment_icons | default: 'ideal, visa, master, paypal, apple_pay, google_pay'
    assign types = raw | replace: ' ', '' | split: ','
  endif
-%}
<div class="gg-payments{% if center %} gg-payments--center{% endif %}{% if muted %} gg-payments--muted{% endif %}" role="list" aria-label="{{ 'gg.general.payment_methods' | t }}">
  {%- for type in types -%}
    {%- if type != blank -%}
      {%- assign label = type | replace: '_', ' ' | capitalize -%}
      <span class="gg-payments__icon" role="listitem" title="{{ label }}">{{ type | payment_type_svg_tag: class: 'gg-payments__svg' }}</span>
    {%- endif -%}
  {%- endfor -%}
</div>
