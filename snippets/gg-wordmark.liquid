{% comment %}
  Brand wordmark (Mantel and Moss, style "3a"): the name in the serif with wide tracking,
  the word "and" smaller and in a muted moss tone. Word gaps come from CSS margins, not spaces. Takes the name from the theme setting
  "Brand name" and falls back to the store name.
  Usage: {% render 'gg-wordmark' %}
{% endcomment %}
{%- liquid
  assign brand_name = settings.gg_brand_name | strip
  if brand_name == blank
    assign brand_name = shop.name | strip
  endif
  assign words = brand_name | split: ' '
-%}
<span class="gg-wordmark" translate="no">
  {%- for word in words -%}
    {%- assign lower = word | downcase -%}
    {%- if lower == 'and' or lower == '&' or lower == 'en' -%}
      <span class="gg-wordmark__and">{{ word }}</span>
    {%- else -%}
      <span class="gg-wordmark__word">{{ word }}</span>
    {%- endif -%}
  {%- endfor -%}
</span>
