{%- comment -%}
  Header cart icon (Grain and Gold). Re-rendered by Dawn's cart scripts via the
  cart-icon-bubble section, so keep the markup self-contained.
{%- endcomment -%}
{%- render 'gg-icon', icon: 'shopping-bag' -%}
<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- if cart != empty -%}
  <span class="gg-header__bubble" aria-hidden="true">{{ cart.item_count }}</span>
  <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
{%- endif -%}
