{%- liquid
  assign items = blank
  if section.settings.product_source and product != blank
    assign items = product.metafields.custom.reviews.value
  endif
  assign hide = false
  if section.settings.product_source
    if items == blank or items.size == 0
      assign hide = true
    endif
  endif
  assign bg_class = 'gg-section--warm'
  if section.settings.background == 'card'
    assign bg_class = 'gg-section--card'
  elsif section.settings.background == 'page'
    assign bg_class = 'gg-section--page'
  endif
  assign card_class = ''
  if section.settings.background == 'card'
    assign card_class = ' gg-review--page'
  endif
-%}
{%- unless hide -%}
<section class="gg-reviews gg-section {{ bg_class }} gg-section--rule-top" id="reviews">
  <div class="gg-container gg-section__inner gg-reviews__inner">
    {%- if section.settings.use_section_heading -%}
      {%- capture h_eyebrow -%}{% render 'gg-t', sid: section.id, field: 'eyebrow', value: section.settings.eyebrow %}{%- endcapture -%}
      {%- capture h_title -%}{% render 'gg-t', sid: section.id, field: 'heading', value: section.settings.heading %}{%- endcapture -%}
      {%- capture h_lead -%}{% render 'gg-t', sid: section.id, field: 'lead', value: section.settings.lead %}{%- endcapture -%}
      {%- render 'gg-heading', eyebrow: h_eyebrow, title: h_title, lead: h_lead -%}
    {%- else -%}
      <div class="gg-reviews__head">
        {%- if section.settings.eyebrow != blank -%}<span class="gg-eyebrow">{% render 'gg-t', sid: section.id, field: 'eyebrow', value: section.settings.eyebrow %}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="gg-h2">{% render 'gg-t', sid: section.id, field: 'heading', value: section.settings.heading %}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="gg-reviews__grid">
      {%- if items != blank -%}
        {%- for r in items limit: 12 -%}
          <div class="gg-review{{ card_class }}">
            {%- render 'gg-rating', value: r.stars, size: 15 -%}
            <p class="gg-review__body">{{ r.body }}</p>
            <div class="gg-review__meta">
              {%- if r.name != blank -%}<span class="gg-review__who">{{ r.name }}</span>{%- endif -%}
              {%- if r.meta != blank -%}<span class="gg-review__note">{{ r.meta }}</span>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
      {%- unless items != blank -%}
      {%- for block in section.blocks -%}
        <div class="gg-review{{ card_class }}" {{ block.shopify_attributes }}>
          {%- render 'gg-rating', value: block.settings.stars, size: 15 -%}
          <p class="gg-review__body">{{ block.settings.body }}</p>
          <div class="gg-review__meta">
            {%- if block.settings.who != blank -%}<span class="gg-review__who">{{ block.settings.who }}</span>{%- endif -%}
            {%- if block.settings.verified -%}
              <span class="gg-review__verified">{% render 'gg-icon', icon: 'shield-check' %}{{ 'gg.reviews.verified' | t }}</span>
            {%- endif -%}
            {%- if block.settings.note != blank -%}<span class="gg-review__note">{{ block.settings.note }}</span>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
      {%- endunless -%}
    </div>
  </div>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "GG Reviews",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What customers say" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "4,7 from 312 reviews", "info": "Placeholder from the design — use your real numbers." },
    { "type": "text", "id": "lead", "label": "Lead (only with section heading style)" },
    { "type": "checkbox", "id": "use_section_heading", "label": "Use section heading style (eyebrow, title, lead)", "default": false },
    { "type": "checkbox", "id": "product_source", "label": "On product pages, use the product's reviews metafield", "default": false, "info": "Reads custom.reviews (JSON) and hides the section when it is empty; the blocks below are ignored." },
    {
      "type": "select", "id": "background", "label": "Background", "default": "warm",
      "options": [
        { "value": "warm", "label": "Warm sand" },
        { "value": "card", "label": "White" },
        { "value": "page", "label": "Cream" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "body", "label": "Review", "default": "Third month of daily use and the glaze still looks new." },
        { "type": "text", "id": "who", "label": "Name and place", "default": "Marieke, Netherlands" },
        { "type": "checkbox", "id": "verified", "label": "Show 'Verified purchase'", "default": true },
        { "type": "text", "id": "note", "label": "Extra line (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Reviews",
      "blocks": [
        { "type": "review", "settings": { "stars": 5, "body": "The pour-over set replaced two things on my counter, which was the point. Third month of daily use and the glaze still looks new. Packed properly, arrived in two days.", "who": "Marieke, Netherlands" } },
        { "type": "review", "settings": { "stars": 4, "body": "I ordered the apron expecting something stiff. It softened after one wash and the ties are long enough to knot in front. The pocket could be a little deeper.", "who": "Jonas, Germany" } },
        { "type": "review", "settings": { "stars": 5, "body": "Wrote on a Sunday about a delayed parcel and had a real answer on Monday morning. The lamp itself is heavier and better made than the photos suggest.", "who": "Aoife, Ireland" } }
      ]
    }
  ]
}
{% endschema %}
