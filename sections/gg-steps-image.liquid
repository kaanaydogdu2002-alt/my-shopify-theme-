{%- liquid
  assign data = blank
  if section.settings.product_source and product != blank
    assign data = product.metafields.custom.included.value
  endif
  assign hide = false
  if section.settings.product_source
    if data == blank or data.items == blank
      assign hide = true
    endif
  endif
  capture eyebrow
    render 'gg-t', sid: section.id, field: 'eyebrow', value: section.settings.eyebrow
  endcapture
  capture heading
    render 'gg-t', sid: section.id, field: 'heading', value: section.settings.heading
  endcapture
  capture image_note
    render 'gg-t', sid: section.id, field: 'image_note', value: section.settings.image_note
  endcapture
  if data != blank
    assign eyebrow = data.eyebrow | default: eyebrow
    assign heading = data.heading | default: heading
    assign image_note = data.image_note | default: image_note
  endif
-%}
{%- unless hide -%}
<section class="gg-section gg-section--page gg-section--rule-top">
  <div class="gg-container gg-section__inner">
    <div class="gg-split">
      <div class="gg-split__text">
        {%- if eyebrow != blank -%}<span class="gg-eyebrow">{{ eyebrow }}</span>{%- endif -%}
        {%- if heading != blank -%}<h2 class="gg-h2" style="max-width:16ch">{{ heading }}</h2>{%- endif -%}
        <div class="gg-steps">
          {%- if data != blank -%}
            {%- for item in data.items limit: 8 -%}
              <div class="gg-step">
                <span class="gg-step__n">{{ forloop.index }}</span>
                <span class="gg-step__text"><strong>{{ item.title }}</strong>{% if item.body != blank %} — {{ item.body }}{% endif %}</span>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              <div class="gg-step" {{ block.shopify_attributes }}>
                <span class="gg-step__n">{{ forloop.index }}</span>
                <span class="gg-step__text"><strong>{% render 'gg-t', sid: section.id, bid: block.id, field: 'title', value: block.settings.title %}</strong>{% if block.settings.body != blank %} — {% render 'gg-t', sid: section.id, bid: block.id, field: 'body', value: block.settings.body %}{% endif %}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      <div class="gg-split__media">
        {%- render 'gg-media', image: section.settings.image, ratio: '4x5', placeholder: image_note, sizes: '(min-width: 990px) 560px, 100vw' -%}
      </div>
    </div>
  </div>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "GG Steps with image",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What is included" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two pieces, one method, four minutes" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_note", "label": "Placeholder note", "default": "In-use image — cone seated on the carafe, kettle mid-pour" },
    { "type": "checkbox", "id": "product_source", "label": "On product pages, use the product's included metafield", "default": false, "info": "Reads custom.included and hides the section when it is empty; the blocks below are ignored." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Stoneware cone" },
        { "type": "text", "id": "body", "label": "Text", "default": "reusable filter, no paper needed." }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Steps with image",
      "blocks": [
        { "type": "step", "settings": { "title": "Stoneware cone", "body": "reusable filter, no paper needed." } },
        { "type": "step", "settings": { "title": "600 ml carafe", "body": "two large cups, marked at 300 and 600 ml." } },
        { "type": "step", "settings": { "title": "Rinse and fill", "body": "22 g of medium grind, then pour in three passes." } },
        { "type": "step", "settings": { "title": "Four minutes", "body": "lift the cone off, serve straight from the carafe." } }
      ]
    }
  ]
}
{% endschema %}
