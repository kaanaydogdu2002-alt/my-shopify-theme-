{%- liquid
  assign gg_page = template.name
  if template.suffix != blank
    assign gg_page = gg_page | append: '_' | append: template.suffix
  endif
-%}
{%- liquid
  assign items = blank
  if section.settings.product_source and product != blank
    assign items = product.metafields.custom.reasons.value
    if request.locale.iso_code == 'de' and product.metafields.custom.reasons_de.value != blank
      assign items = product.metafields.custom.reasons_de.value
    endif
  endif
  assign intro = blank
  if section.settings.intro_from_description and product != blank
    assign intro = product.description
  endif
  assign hide = false
  if section.settings.product_source and items == blank and intro == blank
    assign hide = true
  endif
  assign bg_class = 'gg-section--card'
  assign card_class = ' gg-card--page'
  if section.settings.background == 'page'
    assign bg_class = 'gg-section--page'
    assign card_class = ''
  endif
-%}
{%- unless hide -%}
<section class="gg-section {{ bg_class }} gg-section--rule-top">
  <div class="gg-container gg-section__inner" style="display:flex;flex-direction:column;gap:{% if section.settings.align == 'center' %}32px{% else %}28px{% endif %}">
    {%- capture h_eyebrow -%}{% render 'gg-t', page: gg_page, sid: section.id, field: 'eyebrow', value: section.settings.eyebrow %}{%- endcapture -%}
    {%- capture h_title -%}{% render 'gg-t', page: gg_page, sid: section.id, field: 'heading', value: section.settings.heading %}{%- endcapture -%}
    {%- capture h_lead -%}{% render 'gg-t', page: gg_page, sid: section.id, field: 'lead', value: section.settings.lead %}{%- endcapture -%}
    {%- render 'gg-heading', eyebrow: h_eyebrow, title: h_title, lead: h_lead, align: section.settings.align -%}
    {%- if intro != blank -%}
      <div class="gg-intro gg-rte">{{ intro }}</div>
    {%- endif -%}
    {%- if section.settings.show_image -%}
      <div class="gg-intro-media">
        {%- capture image_note -%}{% render 'gg-t', page: gg_page, sid: section.id, field: 'image_note', value: section.settings.image_note %}{%- endcapture -%}
        {%- render 'gg-media', image: section.settings.image, ratio: '4x3', placeholder: image_note, alt: h_title, sizes: '(min-width: 990px) 860px, 100vw' -%}
      </div>
    {%- endif -%}
    {%- if items != blank -%}
      <div class="gg-grid gg-grid--3{% if items.size == 2 %} gg-grid--two{% endif %}">
        {%- for item in items limit: 6 -%}
          <div class="gg-card{{ card_class }}">
            {%- if item.icon != blank and item.icon != 'none' -%}<span class="gg-card__icon">{% render 'gg-icon', icon: item.icon %}</span>{%- endif -%}
            <h3 class="gg-card__title">{{ item.title }}</h3>
            <p class="gg-card__body">{{ item.body }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="gg-grid gg-grid--3{% if section.blocks.size == 2 %} gg-grid--two{% endif %}">
        {%- for block in section.blocks -%}
          <div class="gg-card{{ card_class }}" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}<span class="gg-card__icon">{% render 'gg-icon', icon: block.settings.icon %}</span>{%- endif -%}
            <h3 class="gg-card__title">{% render 'gg-t', page: gg_page, sid: section.id, bid: block.id, field: 'title', value: block.settings.title %}</h3>
            <p class="gg-card__body">{% render 'gg-t', page: gg_page, sid: section.id, bid: block.id, field: 'body', value: block.settings.body %}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "GG Icon cards",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why this one" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three reasons it stays on the counter" },
    { "type": "text", "id": "lead", "label": "Lead" },
    { "type": "select", "id": "align", "label": "Heading alignment", "default": "center", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "type": "select", "id": "background", "label": "Background", "default": "card", "options": [ { "value": "card", "label": "White" }, { "value": "page", "label": "Cream" } ] },
    { "type": "checkbox", "id": "intro_from_description", "label": "Use the product description as intro text", "default": false, "info": "On product pages, shows the product's own description under the heading." },
    { "type": "checkbox", "id": "show_image", "label": "Show an image under the intro text", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_note", "label": "Placeholder note", "default": "Product image — the boards side by side on a counter" },
    { "type": "checkbox", "id": "product_source", "label": "On product pages, use the product's reasons metafield", "default": false, "info": "Reads custom.reasons and hides the section when it is empty; the blocks below are ignored." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "leaf",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "temperature", "label": "Temperature" },
            { "value": "rotate", "label": "Rotate / returns" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "clock", "label": "Clock" },
            { "value": "check", "label": "Check" },
            { "value": "heart", "label": "Heart" },
            { "value": "package", "label": "Package" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "flame", "label": "Flame" },
            { "value": "sun", "label": "Sun" },
            { "value": "home", "label": "Home" },
            { "value": "mail", "label": "Mail" },
            { "value": "user", "label": "Person" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "No paper, no aftertaste" },
        { "type": "textarea", "id": "body", "label": "Text", "default": "The fine stoneware filter holds the grounds, so nothing but coffee reaches the carafe." }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Icon cards",
      "blocks": [
        { "type": "card", "settings": { "icon": "leaf", "title": "No paper, no aftertaste", "body": "The fine stoneware filter holds the grounds, so nothing but coffee reaches the carafe." } },
        { "type": "card", "settings": { "icon": "temperature", "title": "Holds heat to the last cup", "body": "Thick walls keep a full 600 ml carafe above 60°C for around forty minutes." } },
        { "type": "card", "settings": { "icon": "rotate", "title": "Dishwasher safe, both parts", "body": "Fired at 1240°C, so the glaze does not craze or stain after repeated cycles." } }
      ]
    }
  ]
}
{% endschema %}
