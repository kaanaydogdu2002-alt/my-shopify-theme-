{%- style -%}
  .test-banner-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    text-align: center;
  }

  .test-banner-{{ section.id }} .test-banner__heading {
    margin: 0;
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: inherit;
  }

  @media screen and (max-width: 749px) {
    .test-banner-{{ section.id }} .test-banner__heading {
      font-size: {{ section.settings.text_size | times: 0.55 | round }}px;
    }
  }
{%- endstyle -%}

<div class="test-banner-{{ section.id }}">
  <div class="page-width">
    <h2 class="test-banner__heading">{{ section.settings.heading | escape }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "Test banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Tekst",
      "default": "hallo"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Achtergrondkleur",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstkleur",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Tekstgrootte",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Ruimte boven",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Ruimte onder",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Test banner"
    }
  ]
}
{% endschema %}
