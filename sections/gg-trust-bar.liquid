<div class="gg-trust gg-section">
  <div class="gg-container gg-trust__inner">
    {%- for block in section.blocks -%}
      <span class="gg-trust__item" {{ block.shopify_attributes }}>
        {%- render 'gg-icon', icon: block.settings.icon, class: block.settings.icon_class -%}
        <span class="gg-hide-mobile">{% render 'gg-t', page: 'trust', bid: block.id, field: 'text', value: block.settings.text %}</span>
        {%- assign text_mobile = block.settings.text_mobile | default: block.settings.text -%}
        <span class="gg-hide-desktop">{% render 'gg-t', page: 'trust', bid: block.id, field: 'text_mobile', value: text_mobile %}</span>
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "GG Trust bar",
  "tag": "div",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "lock",
          "options": [
            { "value": "star-filled", "label": "Star" },
            { "value": "lock", "label": "Lock" },
            { "value": "truck", "label": "Truck" },
            { "value": "rotate", "label": "Returns" },
            { "value": "shield-check", "label": "Shield" },
            { "value": "check", "label": "Check" },
            { "value": "clock", "label": "Clock" },
            { "value": "package", "label": "Package" }
          ]
        },
        {
          "type": "select",
          "id": "icon_class",
          "label": "Icon colour",
          "default": "",
          "options": [
            { "value": "", "label": "Ink" },
            { "value": "gg-icon--gold", "label": "Gold" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Secure checkout" },
        { "type": "text", "id": "text_mobile", "label": "Shorter text for phones (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "star-filled", "icon_class": "gg-icon--gold", "text": "4,7 from 312 reviews", "text_mobile": "4,7 · 312 reviews" } },
        { "type": "item", "settings": { "icon": "lock", "text": "Secure checkout" } },
        { "type": "item", "settings": { "icon": "truck", "text": "Tracked worldwide shipping", "text_mobile": "Tracked worldwide" } },
        { "type": "item", "settings": { "icon": "rotate", "text": "30-day returns" } }
      ]
    }
  ]
}
{% endschema %}
