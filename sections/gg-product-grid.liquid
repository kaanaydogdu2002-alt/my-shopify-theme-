{%- liquid
  assign gg_page = template.name
  if template.suffix != blank
    assign gg_page = gg_page | append: '_' | append: template.suffix
  endif
-%}
{%- liquid
  assign collection = section.settings.collection
  if collection != blank
    assign products = collection.products
  else
    assign products = collections.all.products
  endif
  assign limit = section.settings.limit
-%}
<section class="gg-products gg-section gg-section--page gg-section--rule-top" id="shop">
  <div class="gg-container gg-section__inner gg-products__inner">
    {%- capture h_eyebrow -%}{% render 'gg-t', page: gg_page, sid: section.id, field: 'eyebrow', value: section.settings.eyebrow %}{%- endcapture -%}
    {%- capture h_title -%}{% render 'gg-t', page: gg_page, sid: section.id, field: 'heading', value: section.settings.heading %}{%- endcapture -%}
    {%- capture h_lead -%}{% render 'gg-t', page: gg_page, sid: section.id, field: 'lead', value: section.settings.lead %}{%- endcapture -%}
    {%- render 'gg-heading', eyebrow: h_eyebrow, title: h_title, lead: h_lead -%}
    <div class="gg-products__grid">
      {%- for product in products limit: limit -%}
        {%- render 'gg-product-card', product: product, show_rating: section.settings.show_rating, placeholder_rating: section.settings.placeholder_rating, placeholder_count: section.settings.placeholder_count -%}
      {%- else -%}
        <div class="gg-products__empty" style="grid-column: 1 / -1">{{ 'gg.general.no_products' | t }}</div>
      {%- endfor -%}
    </div>
    {%- if section.settings.show_payments -%}
      <div class="gg-products__checkout">
        <span class="gg-products__checkout-label">{% render 'gg-t', page: gg_page, sid: section.id, field: 'payments_label', value: section.settings.payments_label %}</span>
        {%- render 'gg-payments', center: true -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GG Product grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six things we stand behind" },
    { "type": "text", "id": "lead", "label": "Lead", "default": "Small batches, named materials, and a repair or refund if one of them lets you down." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating on cards", "default": true, "info": "Uses the product's reviews.rating metafield (filled by a reviews app)." },
    { "type": "range", "id": "placeholder_rating", "label": "Placeholder rating until real ratings exist", "min": 0, "max": 5, "step": 0.1, "default": 0, "info": "0 = show nothing until a reviews app provides real ratings." },
    { "type": "number", "id": "placeholder_count", "label": "Placeholder review count" },
    { "type": "checkbox", "id": "show_payments", "label": "Show payment methods", "default": true },
    { "type": "text", "id": "payments_label", "label": "Payment label", "default": "Secure checkout with" }
  ],
  "presets": [ { "name": "GG Product grid" } ]
}
{% endschema %}
